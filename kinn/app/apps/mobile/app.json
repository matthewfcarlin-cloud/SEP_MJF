{
  "expo": {
    "name": "RECO",
    "slug": "reco",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.recoapp.recovery",
      "appleTeamId": "GK97AW599V",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.recoapp.recovery"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-source-modules",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "RECO uses the microphone when you choose to speak a note about your knee.",
          "speechRecognitionPermission": "RECO turns your words into text on this phone when you choose to speak."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RECO uses the microphone when you choose to speak a note about your knee."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RECO lets you attach a photo of your knee. It stays on this phone.",
          "cameraPermission": "RECO lets you take a photo of your knee. It stays on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/try"
    }
  }
}
