# What a hosted server needs. Production is the default: with RECO_ENV unset the server refuses
# to start unless everything below is set. `npm run dev` sets RECO_ENV=development, which needs
# none of this: it uses an embedded Postgres under .data/ and shows sign-in codes on the page.

# Postgres connection string (Neon through Vercel Storage, or any Postgres 14+).
DATABASE_URL=
# 32+ random characters. Signs sign-in codes and sharing codes. `openssl rand -base64 48`
AUTH_SECRET=
# 32 random bytes, base64. Encrypts every record and plan before it is stored. `openssl rand -base64 32`
DATA_KEY=
# Resend API key and sender, for sign-in emails.
RESEND_API_KEY=
FROM_EMAIL="RECO <hello@example.com>"
# Who may open a PT account: emails and @domains, comma separated.
PT_ALLOWLIST=
# Sites allowed to call the server from a browser, comma separated (the clinic site's address).
CORS_ORIGINS=
# Leave unset on a host (production). Only a laptop sets RECO_ENV=development.
PORT=8787
